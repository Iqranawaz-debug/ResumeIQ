# Copy to .env (never commit .env). Every value is optional.

# AI features are opt-in per action; without a key, local rules are used.
# Any OpenAI-compatible provider works. Default: OpenRouter.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-oss-20b:free
# Google Gemini directly (key from Google AI Studio):
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   AI_MODEL=gemini-2.5-flash
# OPENROUTER_API_KEY / OPENROUTER_MODEL are still accepted for older setups.

# Browser origins allowed to call the API (comma-separated, exact scheme/host/port).
ALLOWED_ORIGINS=http://localhost:8080

# Inactive users' working data is erased after this many seconds.
DATA_RETENTION_SECONDS=7200
SESSION_TTL_SECONDS=3600

# Set to a file path to persist working data in SQLite (docker-compose sets this).
RESUMEIQ_DB_PATH=
